{
  "name": "binder-tracker",
  "version": "2.0.0",
  "private": true,
  "description": "Binder Tracker: free, unofficial checklists for Pokémon TCG sets, with reverse holos, promos, copy counts and binder pages. Works offline, no sign-up, and your collection stays in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/local/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/check.mjs",
    "set-list": "node scripts/local/build-set-list.mjs",
    "sets": "node scripts/local/build-sets.mjs",
    "images": "node scripts/local/build-images.mjs",
    "images:force": "node scripts/local/build-images.mjs --force",
    "prices": "node scripts/build-prices.mjs",
    "scan-index": "node scripts/local/build-scan-index.mjs",
    "scan-eval": "node scripts/local/scan-eval.mjs"
  },
  "devDependencies": {
    "onnxruntime-node": "1.30.0",
    "onnxruntime-web": "1.30.0",
    "sharp": "^0.35.4"
  }
}
